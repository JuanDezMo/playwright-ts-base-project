{
  "name": "playwright-banking-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Automated tests (Playwright) for the Banking Test Lab web app and Go API",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api-component",
    "test:ui:component": "playwright test --project=ui-component",
    "test:ui:e2e": "playwright test --project=ui-e2e",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "gen:mocks": "node scripts/gen-mocks.ts && pnpm gen:types",
    "gen:types": "openapi-typescript ${OPENAPI_PATH:-../accounts_api/openapi.yaml} -o src/mocks/api-types.ts",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "yaml": "^2.9.1"
  }
}
